
# Telegram Bot Token (@BotFather'dan alınır)
# Örnek: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=

# Telegram Bildirim Gönderilecek Chat ID veya Kanal Kullanıcı Adı
# Birden fazla ID için virgülle ayırabilirsiniz: 123456789,987654321,@deprem_kanali
# Kendi Chat ID'nizi öğrenmek için botunuza /start yazabilirsiniz.
TELEGRAM_CHAT_ID=

# Bot Kullanıcı Adı (İsteğe Bağlı, örn: DepremBilgiBot)
TELEGRAM_BOT_USERNAME=

# Otomatik Alarm Büyüklük Eşiği (Örn: 4.0 veya 3.0)
# Sadece bu büyüklük ve üzerindeki depremlerde bildirim gönderilir.
MIN_MAGNITUDE=4.0

# Bildirim Bölgesi (turkey, global, marmara, ege, akdeniz)
ALERT_REGION=

# İsteğe Bağlı: Belirli Şehir/Konum Filtresi (Virgülle ayrılmış)
# Örnek: ALERT_LOCATIONS=İstanbul,İzmir,Ege,Marmara
ALERT_LOCATIONS=

# İsteğe Bağlı: Maksimum Derinlik (km cinsinden, örn: 50)
MAX_DEPTH=

# Cron Zaman Penceresi (Dakika cinsinden, varsayılan: 15)
# Son kaç dakika içinde gerçekleşen depremler taranacak
CHECK_WINDOW_MINUTES=

# Vercel Cron Güvenlik Parolası (İsteğe Bağlı)
CRON_SECRET=

# İsteğe Bağlı: Upstash Redis / Vercel KV (Mükerrer bildirim önleme ve filtre kaydı için)
KV_REST_API_URL=
KV_REST_API_TOKEN=
